# Cabeçalhos de segurança — lidos pelo Cloudflare Pages e pelo Netlify.
# (Na Vercel, os mesmos valores estão em vercel.json.)
# A CSP principal (com hashes dos scripts) vai em <meta> no HTML, gerada por
# scripts/prerender.mjs; aqui fica só o que <meta> não suporta (frame-ancestors).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable
